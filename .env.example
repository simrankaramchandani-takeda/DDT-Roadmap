# Copy to .env.local and fill in.
#
# Create an API token at: https://id.atlassian.com/manage-profile/security/api-tokens
# The token needs only read access to the DDT Jira projects.

JIRA_BASE_URL=https://onetakeda.atlassian.net
JIRA_EMAIL=you@takeda.com
JIRA_API_TOKEN=

# Optional: override the "today" used for risk derivation, for reproducible runs.
# Format: YYYY-MM-DD
# SNAPSHOT_AS_OF=2026-08-05


# ---------------------------------------------------------------------------
# OData feed probe (npm run probe-odata). Read-only; answers E1-E3, E5 and E7
# in reference/adr-001-data-source.md. NOT used by the sync.
#
# The feed is the Alpha Serve Power BI Connector export endpoint that powers the
# DDTRoadmap Power BI solution. Probed 2026-08-06: reachable from an ordinary
# workstation (no on-prem gateway), and it answers 401 with
# "WWW-Authenticate: Basic". The URL token alone grants nothing.
#
# Treat the feed URL as a secret: keep it in .env.local, never commit it.
# ---------------------------------------------------------------------------

# ODATA_FEED_URL=https://powerbi-cloud-prod.alphaservesp.com/api/export/power-bi/<token>
# ODATA_AUTH_MODE=basic                  # basic | bearer | oauth2 | anonymous

# basic -- the scheme this endpoint actually advertises.
# Ask for a SERVICE credential, not a personal login: a named individual's
# account relocates the key-person dependency the OData move exists to remove,
# and ties the roadmap's data scope to that person's Jira permissions.
# ODATA_USERNAME=
# ODATA_PASSWORD=

# Retained for other feeds; not advertised by this endpoint.
# ODATA_TOKEN=
# ODATA_TOKEN_URL=
# ODATA_CLIENT_ID=
# ODATA_CLIENT_SECRET=
# ODATA_SCOPE=

# Only needed if auto-detection of the payload shape fails.
# ODATA_ISSUE_ENTITY=
# ODATA_PROJECT_KEY_FIELD=
