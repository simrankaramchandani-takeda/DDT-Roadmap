# Copy to .env.local and fill in.
#
# Create an API token at: https://id.atlassian.com/manage-profile/security/api-tokens
# The token needs only read access to the DDT Jira projects.

JIRA_BASE_URL=https://onetakeda.atlassian.net
JIRA_EMAIL=you@takeda.com
JIRA_API_TOKEN=

# Optional: override the "today" used for risk derivation, for reproducible runs.
# Format: YYYY-MM-DD
# SNAPSHOT_AS_OF=2026-08-05


# ---------------------------------------------------------------------------
# OData feed probe (npm run probe-odata). Read-only; answers E1-E3 in
# reference/adr-001-data-source.md. Not used by the sync.
#
# ODATA_FEED_URL is the same endpoint the DDTRoadmap Power BI report connects
# to -- copy it from that report's data source settings.
# ---------------------------------------------------------------------------

# ODATA_FEED_URL=https://<host>/<path>
# ODATA_AUTH_MODE=oauth2                 # oauth2 | bearer | basic | anonymous

# oauth2 -- client credentials. The only mode a scheduled sync can rely on,
# and the one that actually answers E1.
# ODATA_TOKEN_URL=https://login.microsoftonline.com/<tenant>/oauth2/v2.0/token
# ODATA_CLIENT_ID=
# ODATA_CLIENT_SECRET=
# ODATA_SCOPE=

# bearer -- a token you already hold. Proves E2/E3 but NOT E1.
# ODATA_TOKEN=

# basic
# ODATA_USERNAME=
# ODATA_PASSWORD=

# Only needed if auto-detection from $metadata fails.
# ODATA_ISSUE_ENTITY=
# ODATA_PROJECT_KEY_FIELD=
